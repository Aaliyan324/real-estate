# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The Prisma provider is chosen by which schema you generate against, NOT by
# this URL. See DATABASE.md.
#
#   MySQL / MariaDB (default, Hostinger + local dev):
#     schema:  prisma/schema.prisma
#     DATABASE_URL uses the mysql:// scheme.
#
#   PostgreSQL / Neon (Vercel):
#     schema:  prisma/schema.postgresql.prisma
#     DATABASE_URL uses the postgresql:// scheme.
#
# Local MySQL/MariaDB example (development only — production Hostinger uses a
# real hostname, never localhost):
DATABASE_URL="mysql://username:password@localhost:3306/real_estate_db"

# PostgreSQL / Neon example (uncomment to target Vercel/Neon, and generate the
# postgres schema first). For serverless, prefer Neon's pooled "-pooler" host.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Optional: direct (non-pooled) connection for Prisma CLI / migrations / db push:
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate a strong secret for production (32+ chars). Never commit a real one.
AUTH_SECRET="your-super-secret-auth-key-change-in-production-32-chars-min"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Maps API Key (client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---------------------------------------------------------------------------
# File storage (image uploads)
# ---------------------------------------------------------------------------
# Leave unset to store uploads on the local filesystem (Hostinger / local dev).
# Set a Vercel Blob token to automatically switch uploads to Vercel Blob
# (required for Vercel, whose filesystem is ephemeral). Server-side only —
# never expose this as a NEXT_PUBLIC_* variable.
#
# The Blob store is expected to be PRIVATE. Uploads use access: 'private' and
# images are served through the server-side proxy at /api/blob/<pathname>, so
# the read-write token never reaches the browser and files stay non-public.
# BLOB_READ_WRITE_TOKEN=""
